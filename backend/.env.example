# Server-wide Groq key. Used for any run that doesn't carry a personal key.
# Users can also bring their own key in the app (Settings > Groq API key), which
# is sent per-run as the `x-groq-key` header and overrides this one for that run.
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Owner passcode for the Reports history. Leave blank in local dev (Reports is open).
# Set it before deploying so the Reports tab stays hidden from end users and listing
# or deleting runs requires this key. Unlock it in the app under Settings > Owner access.
POLARIS_ADMIN_KEY=

# Who may spend LLM quota. When true, POST /api/runs requires either the owner key
# or the caller's own Groq key, so nobody can burn GROQ_API_KEY above anonymously.
# Defaults to true whenever POLARIS_ADMIN_KEY is set, false otherwise.
POLARIS_REQUIRE_KEY_FOR_RUNS=

# Per-IP cap on new analyses per rolling hour (the owner key is exempt).
POLARIS_RUNS_PER_HOUR=20

# CORS allowlist for the deployed frontend, comma-separated. Unset means any origin,
# which is fine locally. Example: https://polaris.example.com,http://localhost:5173
POLARIS_ALLOWED_ORIGINS=

# Watchdog timings. A single analysis is abandoned after RUN_TIMEOUT_SECONDS, and any
# run still mid-flight after STALE_RUN_SECONDS of no updates (e.g. the backend was
# restarted mid-run) is retired so the dashboard stops polling it forever.
POLARIS_RUN_TIMEOUT_SECONDS=300
POLARIS_STALE_RUN_SECONDS=330
